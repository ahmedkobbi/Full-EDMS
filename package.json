{
  "name": "smart-edms",
  "version": "1.0.0",
  "private": true,
  "description": "Smart EDMS — Premium, enterprise-grade, multilingual, on-premise Electronic Document Management System.",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter=./apps/* --filter=./packages/* build",
    "dev": "pnpm -r --parallel --filter=./apps/* dev",
    "lint": "pnpm -r --filter=./apps/* --filter=./packages/* lint",
    "typecheck": "pnpm -r --filter=./apps/* --filter=./packages/* typecheck",
    "test": "pnpm -r --filter=./apps/* --filter=./packages/* test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "i18n:check": "pnpm --filter @smart-edms/i18n check",
    "i18n:extract": "pnpm --filter @smart-edms/i18n extract",
    "db:generate": "pnpm --filter @smart-edms/backend db:generate",
    "db:migrate": "pnpm --filter @smart-edms/backend db:migrate",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "tsup": "^8.3.0"
  },
  "prettier": {
    "semi": true,
    "singleQuote": true,
    "trailingComma": "all",
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false
  }
}

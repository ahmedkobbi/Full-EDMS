# Use pnpm for workspace management (spec §7 — packageManager field in root package.json)
auto-install-peers=true
strict-peer-dependencies=false
shamefully-hoist=false
node-linker=isolated
hoist-pattern[]=*prisma*
hoist-pattern[]=*electron*
hoist-pattern[]=*playwright*

# Allow pnpm to use the workspace's TypeScript
dedupe-peer-dependents=true
save-prefix=

# Lockfile settings
lockfile-link=true
frozen-lockfile=false

// ────────────────────────────────────────────────────────────────────────────
// License Local State (per on-premise deployment)
// ────────────────────────────────────────────────────────────────────────────

model LicenseLocalState {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @db.Uuid
  licenseId         String?  @db.Uuid
  deploymentId      String   @unique @db.VarChar(128)
  environment       String   @default("production") @db.VarChar(32)
  state             String   @default("invalid") @db.VarChar(32)
  kid               String?  @db.VarChar(64)
  alg               String?  @db.VarChar(16)
  payloadJson       Json?
  signature         String?  @db.Text
  fingerprintHash   String?  @db.VarChar(128)
  lastHeartbeatAt   DateTime? @db.Timestamptz(3)
  heartbeatFailures Int      @default(0)
  graceExhaustedAt  DateTime? @db.Timestamptz(3)
  importedAt        DateTime? @db.Timestamptz(3)
  importedByUserId  String?  @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  // ── Enterprise-grade hardening fields ──────────────────────────
  // Encrypted payload (AES-256-GCM, DEK derived from machine fingerprint)
  encryptedPayload  String?  @db.Text
  // Max observed wall-clock timestamp (for clock skew detection)
  maxObservedTimestamp String?  @db.VarChar(32)
  // Integrity baseline hash (SHA-256 of critical file hashes)
  integrityBaseline String?  @db.Text
  // Last integrity check result
  lastIntegrityOk   Boolean? @default(true)
  lastIntegrityCheckAt DateTime? @db.Timestamptz(3)
  // CRL (revocation list) last checked
  crlLastCheckedAt  DateTime? @db.Timestamptz(3)
  // Wrapped public key envelope (KEK-wrapped)
  wrappedPublicKey  String?  @db.Text

  @@map("license_local_state")
}

// ────────────────────────────────────────────────────────────────────────────
// Scanner / Digitization
// ────────────────────────────────────────────────────────────────────────────

model ScannerProfile {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  code              String   @db.VarChar(64)
  name              String
  driverKind        String   @default("upload") @db.VarChar(32)
  deviceId          String?  @db.VarChar(128)
  settings          Json
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobs              ScannerJob[]

  @@unique([tenantId, code])
  @@map("scanner_profiles")
}

model ScannerJob {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  profileId         String?  @db.Uuid
  documentId        String?  @db.Uuid
  status            ScannerJobStatus @default(PENDING)
  totalFiles        Int      @default(0)
  processedFiles    Int      @default(0)
  failedFiles       Int      @default(0)
  ocrLanguage       String?  @db.VarChar(32)
  confidenceScore   Float?
  errorMessage      String?  @db.Text
  startedAt         DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile           ScannerProfile? @relation(fields: [profileId], references: [id])
  document          Document? @relation(fields: [documentId], references: [id])

  @@index([tenantId, status])
  @@index([tenantId, createdByUserId])
  @@map("scanner_jobs")
}

enum ScannerJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  QUARANTINED
}

// ────────────────────────────────────────────────────────────────────────────
// Guided Tour
// ────────────────────────────────────────────────────────────────────────────

model TourDefinition {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  code              String   @db.VarChar(64)
  module            String   @db.VarChar(64)
  audience          String[] @default([])
  priority          Int      @default(100)
  version           Int      @default(1)
  triggerType       String   @db.VarChar(32)
  enabled           Boolean  @default(true)
  licenseModuleRequired String? @db.VarChar(64)
  steps             TourStep[]
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userStates        TourUserState[]

  @@unique([tenantId, code])
  @@index([tenantId, enabled])
  @@map("tour_definitions")
}

model TourStep {
  id                String   @id @default(uuid()) @db.Uuid
  tourId            String   @db.Uuid
  stepOrder         Int
  targetSelector    String   @db.VarChar(128)
  titleKey          String
  bodyKey           String
  placement         String   @default("auto") @db.VarChar(16)
  requiresPermission String?  @db.VarChar(128)
  requiresLicenseModule String? @db.VarChar(64)
  actionType        String?  @db.VarChar(32)
  waitForEvent      String?  @db.VarChar(64)
  enabled           Boolean  @default(true)

  tour              TourDefinition @relation(fields: [tourId], references: [id], onDelete: Cascade)

  @@index([tourId, stepOrder])
  @@map("tour_steps")
}

model TourUserState {
  id                String   @id @default(uuid()) @db.Uuid
  tourId            String   @db.Uuid
  userId            String   @db.Uuid
  tenantId          String   @db.Uuid
  status            TourUserStatus @default(NOT_STARTED)
  currentStepId     String?  @db.Uuid
  currentStepOrder  Int      @default(0)
  startedAt         DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  skippedAt         DateTime? @db.Timestamptz(3)
  doNotShowAgain    Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tour              TourDefinition @relation(fields: [tourId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tourId, userId])
  @@index([tenantId, userId, status])
  @@map("tour_user_states")
}

enum TourUserStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
  DISMISSED
}

// ────────────────────────────────────────────────────────────────────────────
// AI Assistant
// ────────────────────────────────────────────────────────────────────────────

model AssistantSettings {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @unique @db.Uuid
  enabled           Boolean  @default(false)
  allowedRoles      String[] @default([])
  allowedTools      String[] @default([])
  externalAiAllowed Boolean  @default(false)
  localOnlyMode     Boolean  @default(false)
  modelProvider     String?  @db.VarChar(64)
  chatRetentionDays Int      @default(30)
  showCitations     Boolean  @default(true)
  allowNavigationActions Boolean @default(false)
  allowSuggestedActions Boolean @default(true)
  requireDisclaimer Boolean  @default(true)
  rateLimitPerMinute Int     @default(20)
  usageQuotaPerDay  Int      @default(200)
  privacyNotice     String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("assistant_settings")
}

model AssistantSession {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  userId            String   @db.Uuid
  locale            String   @default("en") @db.VarChar(16)
  status            String   @default("active") @db.VarChar(16)
  modelProvider     String?  @db.VarChar(64)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          AssistantMessage[]

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@map("assistant_sessions")
}

model AssistantMessage {
  id                String   @id @default(uuid()) @db.Uuid
  sessionId         String   @db.Uuid
  tenantId          String   @db.Uuid
  userId            String   @db.Uuid
  role              String   @db.VarChar(16)
  contentSummary    String   @db.Text
  contentHash       String   @db.VarChar(128)
  modelProvider     String?  @db.VarChar(64)
  citationsJson     Json?
  suggestedActions  Json?
  disclaimerKey     String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  session           AssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  toolInvocations   AssistantToolInvocation[]
  actions           AssistantAction[]

  @@index([tenantId, sessionId])
  @@index([tenantId, createdAt])
  @@map("assistant_messages")
}

model AssistantToolInvocation {
  id                String   @id @default(uuid()) @db.Uuid
  messageId         String   @db.Uuid
  sessionId         String   @db.Uuid
  tenantId          String   @db.Uuid
  toolName          String   @db.VarChar(64)
  inputSummary      String   @db.Text
  outputSummary     String   @db.Text
  status            String   @db.VarChar(16)
  authorized        Boolean  @default(false)
  occurredAt        DateTime @default(now()) @db.Timestamptz(3)

  message           AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@index([tenantId, toolName])
  @@map("assistant_tool_invocations")
}

model AssistantAction {
  id                String   @id @default(uuid()) @db.Uuid
  messageId         String   @db.Uuid
  sessionId         String   @db.Uuid
  tenantId          String   @db.Uuid
  actionType        String   @db.VarChar(32)
  targetType        String   @db.VarChar(32)
  targetId          String?  @db.Uuid
  confirmationRequired Boolean @default(true)
  confirmedAt       DateTime? @db.Timestamptz(3)
  executedAt        DateTime? @db.Timestamptz(3)
  status            String   @db.VarChar(16) @default("suggested")

  message           AssistantMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, sessionId])
  @@map("assistant_actions")
}

model AssistantAuditEvent {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  userId            String   @db.Uuid
  sessionId         String?  @db.Uuid
  messageId         String?  @db.Uuid
  category          String   @db.VarChar(64)
  code              String   @db.VarChar(64)
  result            String   @db.VarChar(16)
  metadata          Json?
  occurredAt        DateTime @default(now()) @db.Timestamptz(3)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, userId])
  @@map("assistant_audit_events")
}

// ────────────────────────────────────────────────────────────────────────────
// API Keys, Webhooks, Jobs, Locale Resources
// ────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  name              String
  keyHash           String   @unique @db.VarChar(128)
  keyPrefix         String   @db.VarChar(16)
  scopes            String[]
  lastUsedAt        DateTime? @db.Timestamptz(3)
  expiresAt         DateTime? @db.Timestamptz(3)
  isActive          Boolean  @default(true)
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("api_keys")
}

model Webhook {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  url               String
  secretHash        String?  @db.VarChar(128)
  events            String[]
  isActive          Boolean  @default(true)
  lastDeliveryAt    DateTime? @db.Timestamptz(3)
  lastDeliveryStatus String? @db.VarChar(16)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isActive])
  @@map("webhooks")
}

model Job {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  kind              String   @db.VarChar(64)
  status            String   @default("queued") @db.VarChar(16)
  payload           Json
  result            Json?
  errorMessage      String?  @db.Text
  attempts          Int      @default(0)
  maxAttempts       Int      @default(3)
  scheduledAt       DateTime @default(now()) @db.Timestamptz(3)
  startedAt         DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledAt])
  @@index([tenantId, kind])
  @@map("jobs")
}

model LocaleResource {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  locale            String   @db.VarChar(16)
  namespace         String   @db.VarChar(64)
  key               String   @db.VarChar(128)
  value             String   @db.Text
  isOverride        Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locale, namespace, key])
  @@index([tenantId, locale])
  @@map("locale_resources")
}

// ────────────────────────────────────────────────────────────────────────────
// Saved Searches (spec §9.10)
// ────────────────────────────────────────────────────────────────────────────

model SavedSearch {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  ownerUserId       String   @db.Uuid
  name              String   @db.VarChar(200)
  // Stored as JSON matching the `SearchQuery` shape from @smart-edms/types.
  query             Json
  // Optional alert subscription — null when not subscribed.
  alertEnabled      Boolean  @default(false)
  alertInterval     String?  @db.VarChar(16)
  lastNotifiedAt    DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, ownerUserId])
  @@index([tenantId, alertEnabled, alertInterval])
  @@map("saved_searches")
}

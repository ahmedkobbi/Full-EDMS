// Smart EDMS — Prisma schema
// On-premise backend data model. Every tenant-owned table carries `tenant_id` for
// strict multi-tenant isolation (enforced in code + via row-level security where supported).
// Spec reference: §9.x (product scope), §15.1 (EDMS core entities), §15.3 (tenant isolation).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Identity & Tenancy
// ────────────────────────────────────────────────────────────────────────────

model Tenant {
  id                String   @id @default(uuid()) @db.Uuid
  code              String   @unique
  name              String
  slug              String   @unique
  status            TenantStatus @default(ACTIVE)
  defaultLocale     String   @default("en") @db.VarChar(16)
  enabledLocales    String[] @default(["en", "fr", "ar", "ru", "zh-CN", "de"])
  defaultTheme      String   @default("system") @db.VarChar(16)
  flagConfig        Json     @default("{\"ar\":\"neutral\"}")
  branding          Json?
  dataResidency     String?  @db.VarChar(64)
  quotaUsers        Int      @default(50)
  quotaStorageBytes BigInt   @default(10737418240)
  quotaDocuments    Int      @default(100000)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  users             User[]
  groups            Group[]
  roles             Role[]
  documents         Document[]
  folders           Folder[]
  classifications   ClassificationLabel[]
  metadataSchemas   MetadataSchema[]
  workflows         WorkflowDefinition[]
  retentionSchedules RetentionSchedule[]
  legalHolds        LegalHold[]
  shareLinks        ShareLink[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  scannerProfiles   ScannerProfile[]
  scannerJobs       ScannerJob[]
  tourDefinitions   TourDefinition[]
  tourUserStates    TourUserState[]
  assistantSessions AssistantSession[]
  assistantSettings AssistantSettings?
  apiKeys           ApiKey[]
  webhooks          Webhook[]
  jobs              Job[]
  localeResources   LocaleResource[]
  savedSearches     SavedSearch[]

  @@index([status])
  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

model User {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  email             String
  emailVerified     Boolean  @default(false)
  passwordHash      String?
  firstName         String
  lastName          String
  preferredName     String?
  status            UserStatus @default(ACTIVE)
  mfaEnabled        Boolean  @default(false)
  mfaSecret         String?  @db.VarChar(64)
  mfaBackupCodes    String[] @default([])
  preferredLocale   String?  @db.VarChar(16)
  preferredTheme    String?  @db.VarChar(16) // system | light | dark
  preferredTimezone String?  @db.VarChar(64)
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime? @db.Timestamptz(3)
  lastLoginAt       DateTime? @db.Timestamptz(3)
  lastLoginIp       String?  @db.VarChar(64)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions          Session[]
  groupMemberships  GroupMember[]
  roleAssignments   UserRoleAssignment[]
  documents         Document[]
  lockedDocuments  Document[] @relation("DocumentLockedBy")
  documentComments  DocumentComment[]
  auditEvents       AuditEvent[]
  notifications     Notification[]
  tourUserStates    TourUserState[]
  assistantSessions AssistantSession[]
  assistantAuditEvents AssistantAuditEvent[]
  preferences       UserPreference?
  devices           DeviceTrust[]
  shareLinks        ShareLink[] @relation("ShareLinkCreator")

  @@unique([tenantId, email])
  @@index([tenantId, status])
  @@index([email])
  @@map("users")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  INVITED
  DELETED
}

model UserPreference {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @db.Uuid
  tenantId          String   @db.Uuid
  locale            String   @default("en") @db.VarChar(16)
  theme             String   @default("system") @db.VarChar(16)
  timezone          String   @default("UTC") @db.VarChar(64)
  numbering         String?  @db.VarChar(16)
  direction         String?  @db.VarChar(8)
  reducedMotion     Boolean  @default(false)
  highContrast      Boolean  @default(false)
  tourAutoStart     Boolean  @default(true)
  aiAssistantEnabled Boolean @default(true)
  notificationPrefs Json     @default("{}")
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("user_preferences")
}

model Session {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  tenantId          String   @db.Uuid
  tokenHash         String   @unique
  refreshTokenHash  String?  @unique
  ipAddress         String?  @db.VarChar(64)
  userAgent         String?  @db.Text
  deviceFingerprint String?  @db.VarChar(128)
  status            SessionStatus @default(ACTIVE)
  expiresAt         DateTime @db.Timestamptz(3)
  revokedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model DeviceTrust {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  tenantId          String   @db.Uuid
  fingerprint       String   @db.VarChar(128)
  trusted           Boolean  @default(false)
  firstSeenAt       DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt        DateTime @default(now()) @db.Timestamptz(3)
  metadata          Json?

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([tenantId])
  @@map("device_trust")
}

model Group {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  name              String
  description       String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  members           GroupMember[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("groups")
}

model GroupMember {
  id                String   @id @default(uuid()) @db.Uuid
  groupId           String   @db.Uuid
  userId            String   @db.Uuid
  tenantId          String   @db.Uuid
  role              String   @default("member") @db.VarChar(32)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  group             Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([tenantId, userId])
  @@map("group_members")
}

model Role {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  code              String   @db.VarChar(64)
  name              String
  description       String?
  permissions       String[]
  isSystem          Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments       UserRoleAssignment[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("roles")
}

model UserRoleAssignment {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @db.Uuid
  roleId            String   @db.Uuid
  tenantId          String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role              Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId])
  @@map("user_role_assignments")
}

// ────────────────────────────────────────────────────────────────────────────
// Document Management
// ────────────────────────────────────────────────────────────────────────────

model Folder {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  parentId          String?  @db.Uuid
  name              String
  path              String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents         Document[]

  @@index([tenantId, parentId])
  @@index([tenantId, path])
  @@map("folders")
}

model Document {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  folderId          String?  @db.Uuid
  title             String
  description       String?
  documentType      String?  @db.VarChar(64)
  sourceSystem      String?  @db.VarChar(128)
  contentLanguage   String?  @db.VarChar(16)
  textDirection     String?  @db.VarChar(8)
  tags              String[] @default([])
  classificationId  String?  @db.Uuid
  sensitivityLevel  Int      @default(2)
  status            DocumentStatus @default(ACTIVE)
  isRecord          Boolean  @default(false)
  isLocked          Boolean  @default(false)
  lockedByUserId    String?  @db.Uuid
  lockedAt          DateTime? @db.Timestamptz(3)
  checksumAlgorithm String   @default("sha256") @db.VarChar(16)
  checksum          String?  @db.VarChar(128)
  sizeBytes         BigInt   @default(0)
  currentVersionId  String?  @db.Uuid
  retentionScheduleId String? @db.Uuid
  legalHoldActive   Boolean  @default(false)
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)
  deletedAt         DateTime? @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  folder            Folder?  @relation(fields: [folderId], references: [id])
  classification    ClassificationLabel? @relation(fields: [classificationId], references: [id])
  retentionSchedule RetentionSchedule? @relation(fields: [retentionScheduleId], references: [id])
  createdBy         User     @relation(fields: [createdByUserId], references: [id])
  lockedByUser      User?    @relation("DocumentLockedBy", fields: [lockedByUserId], references: [id])
  versions          DocumentVersion[]
  metadataValues    MetadataValue[]
  shareLinks        ShareLink[]
  auditEvents       AuditEvent[]
  workflowInstances WorkflowInstance[]
  comments          DocumentComment[]
  provenanceManifests ProvenanceManifest[]
  scannerJobs       ScannerJob[]
  legalHolds        LegalHold[] @relation("LegalHoldDocuments")
  dispositionRecords DispositionRecord[]

  @@index([tenantId, status])
  @@index([tenantId, classificationId])
  @@index([tenantId, createdByUserId])
  @@index([tenantId, updatedAt])
  @@index([tenantId, isRecord])
  @@index([tenantId, legalHoldActive])
  @@map("documents")
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  RECORD
  DELETED
  PROCESSING
  QUARANTINED
}

model DocumentVersion {
  id                String   @id @default(uuid()) @db.Uuid
  documentId        String   @db.Uuid
  tenantId          String   @db.Uuid
  versionNumber     Int
  storageKey        String   @db.VarChar(512)
  sizeBytes         BigInt
  checksumAlgorithm String   @default("sha256") @db.VarChar(16)
  checksum          String   @db.VarChar(128)
  mime              String   @db.VarChar(128)
  originalFilename  String
  createdByUserId   String?  @db.Uuid
  changeReason      String?
  isImmutable       Boolean  @default(true)
  encryptionKeyRef  String?  @db.VarChar(128)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([tenantId, documentId])
  @@index([tenantId, createdAt])
  @@map("document_versions")
}

model DocumentComment {
  id                String   @id @default(uuid()) @db.Uuid
  documentId        String   @db.Uuid
  tenantId          String   @db.Uuid
  userId            String   @db.Uuid
  body              String   @db.Text
  anchor            String?
  resolved          Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("document_comments")
}

model MetadataSchema {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  code              String   @db.VarChar(64)
  name              String
  documentType      String?  @db.VarChar(64)
  fields            Json
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("metadata_schemas")
}

model MetadataValue {
  id                String   @id @default(uuid()) @db.Uuid
  documentId        String   @db.Uuid
  tenantId          String   @db.Uuid
  schemaId          String?  @db.Uuid
  fieldCode         String   @db.VarChar(64)
  value             Json
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, fieldCode])
  @@index([tenantId, fieldCode])
  @@map("metadata_values")
}

model ClassificationLabel {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  code              String   @db.VarChar(64)
  nameKey           String
  descriptionKey    String?
  sensitivityLevel  Int
  color             String?  @db.VarChar(16)
  bannerText        String?  @db.Text
  isSystem          Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents         Document[]
  historyFrom        ClassificationHistory[] @relation("ClassificationHistoryFrom")
  historyTo          ClassificationHistory[] @relation("ClassificationHistoryTo")

  @@unique([tenantId, code])
  @@index([tenantId, sensitivityLevel])
  @@map("classification_labels")
}

model ClassificationHistory {
  id                String   @id @default(uuid()) @db.Uuid
  documentId        String   @db.Uuid
  tenantId          String   @db.Uuid
  fromLabelId       String?  @db.Uuid
  toLabelId         String?  @db.Uuid
  reason            String?
  changedByUserId   String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  fromLabel         ClassificationLabel? @relation("ClassificationHistoryFrom", fields: [fromLabelId], references: [id])
  toLabel           ClassificationLabel? @relation("ClassificationHistoryTo", fields: [toLabelId], references: [id])

  @@index([tenantId, documentId, createdAt])
  @@map("classification_history")
}

// ────────────────────────────────────────────────────────────────────────────
// Workflows (BPMN / CMMN / DMN)
// ────────────────────────────────────────────────────────────────────────────

model WorkflowDefinition {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  code              String   @db.VarChar(64)
  name              String
  description       String?
  modelKind         WorkflowModelKind
  bpmnXml           String?  @db.Text
  dmnTableXml       String?  @db.Text
  cmmnXml           String?  @db.Text
  definitionJson    Json
  version           Int      @default(1)
  status            WorkflowDefinitionStatus @default(DRAFT)
  isAiDraft         Boolean  @default(false)
  createdByUserId   String   @db.Uuid
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  instances         WorkflowInstance[]

  @@unique([tenantId, code, version])
  @@index([tenantId, status])
  @@map("workflow_definitions")
}

enum WorkflowModelKind {
  BPMN
  CMMN
  DMN
}

enum WorkflowDefinitionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model WorkflowInstance {
  id                String   @id @default(uuid()) @db.Uuid
  definitionId      String   @db.Uuid
  documentId        String?  @db.Uuid
  tenantId          String   @db.Uuid
  status            WorkflowStatus @default(PENDING)
  context           Json
  startedByUserId   String   @db.Uuid
  startedAt         DateTime @default(now()) @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  dueAt             DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  definition        WorkflowDefinition @relation(fields: [definitionId], references: [id])
  document          Document? @relation(fields: [documentId], references: [id])
  steps             WorkflowStep[]
  approvals         Approval[]

  @@index([tenantId, status])
  @@index([tenantId, documentId])
  @@index([tenantId, startedByUserId])
  @@map("workflow_instances")
}

enum WorkflowStatus {
  PENDING
  RUNNING
  APPROVED
  REJECTED
  CANCELLED
  FAILED
  COMPLETED
}

model WorkflowStep {
  id                String   @id @default(uuid()) @db.Uuid
  instanceId        String   @db.Uuid
  tenantId          String   @db.Uuid
  stepKey           String   @db.VarChar(64)
  name              String
  status            String   @default("pending") @db.VarChar(32)
  assigneeId        String?  @db.Uuid
  delegateId        String?  @db.Uuid
  startedAt         DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  dueAt             DateTime? @db.Timestamptz(3)
  metadata          Json?

  instance          WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, instanceId])
  @@index([tenantId, assigneeId, status])
  @@map("workflow_steps")
}

model Approval {
  id                String   @id @default(uuid()) @db.Uuid
  instanceId        String   @db.Uuid
  tenantId          String   @db.Uuid
  approverId        String   @db.Uuid
  decision          ApprovalDecision?
  comment           String?
  signature         String?  @db.Text
  decidedAt         DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  instance          WorkflowInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@index([tenantId, instanceId])
  @@index([tenantId, approverId, decision])
  @@map("approvals")
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  DELEGATED
  ESCALATED
}

// ────────────────────────────────────────────────────────────────────────────
// Retention, Legal Hold, Disposition
// ────────────────────────────────────────────────────────────────────────────

model RetentionSchedule {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  code              String   @db.VarChar(64)
  name              String
  description       String?
  triggerKind       String   @db.VarChar(32)
  triggerDateField  String?  @db.VarChar(64)
  retentionDays     Int
  dispositionAction String   @default("delete") @db.VarChar(32)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents         Document[]
  dispositions      DispositionRecord[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("retention_schedules")
}

model LegalHold {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  code              String   @db.VarChar(64)
  name              String
  reason            String   @db.Text
  caseReference     String?  @db.VarChar(128)
  placedByUserId    String   @db.Uuid
  releasedByUserId  String?  @db.Uuid
  releasedAt        DateTime? @db.Timestamptz(3)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  documents         Document[] @relation("LegalHoldDocuments")
  dispositions      DispositionRecord[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("legal_holds")
}

model DispositionRecord {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  documentId        String   @db.Uuid
  retentionScheduleId String @db.Uuid
  legalHoldId       String?  @db.Uuid
  status            DispositionStatus @default(PENDING)
  scheduledAt       DateTime @db.Timestamptz(3)
  approvedByUserId  String?  @db.Uuid
  approvedAt        DateTime? @db.Timestamptz(3)
  executedAt        DateTime? @db.Timestamptz(3)
  certificateKey    String?  @db.VarChar(512)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  retentionSchedule RetentionSchedule @relation(fields: [retentionScheduleId], references: [id])
  legalHold         LegalHold? @relation(fields: [legalHoldId], references: [id])
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, status, scheduledAt])
  @@map("disposition_records")
}

enum DispositionStatus {
  PENDING
  APPROVED
  EXECUTED
  CANCELLED
  BLOCKED_LEGAL_HOLD
}

// ────────────────────────────────────────────────────────────────────────────
// Audit, Provenance, Evidence
// ────────────────────────────────────────────────────────────────────────────

model AuditEvent {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @db.Uuid
  userId            String?  @db.Uuid
  actorKind         String   @db.VarChar(32)
  category          String   @db.VarChar(64)
  code              String   @db.VarChar(64)
  result            String   @db.VarChar(16)
  resourceType      String?  @db.VarChar(64)
  resourceId        String?  @db.Uuid
  documentId        String?  @db.Uuid
  ipAddress         String?  @db.VarChar(64)
  userAgent         String?  @db.Text
  correlationId     String?  @db.VarChar(64)
  reason            String?  @db.Text
  metadata          Json?
  sequenceNumber    BigInt
  previousHash      String?  @db.VarChar(128)
  eventHash         String   @db.VarChar(128)
  occurredAt        DateTime @default(now()) @db.Timestamptz(3)

  user              User?    @relation(fields: [userId], references: [id])
  document          Document? @relation(fields: [documentId], references: [id])
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, occurredAt])
  @@index([tenantId, code])
  @@index([tenantId, userId])
  @@index([tenantId, resourceType, resourceId])
  @@index([tenantId, correlationId])
  @@map("audit_events")
}

model ProvenanceManifest {
  id                String   @id @default(uuid()) @db.Uuid
  documentId        String   @db.Uuid
  tenantId          String   @db.Uuid
  manifestKind      String   @db.VarChar(32)
  c2paManifest      Json?
  chainOfCustody    Json?
  forgeryVerdict    String?  @db.VarChar(32)
  forgeryScore      Float?
  signedAt          DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([tenantId, documentId])
  @@map("provenance_manifests")
}


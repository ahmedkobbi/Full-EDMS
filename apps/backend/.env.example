# ─────────────────────────────────────────────────────────────────────────────
# Smart EDMS — Backend Development Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust values for local development.
# In production, use the Docker Compose `.env` at `infra/docker/.env`.

# Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# PostgreSQL (local dev — use `docker compose up -d postgres` to start one)
DATABASE_URL=postgresql://smart_edms:smart_edms_dev@localhost:5432/smart_edms?schema=public

# Redis (local dev — use `docker compose up -d redis` to start one)
REDIS_URL=redis://localhost:6379

# OpenSearch (optional in dev — backend falls back to PostgreSQL full-text search)
# OPENSEARCH_URL=http://admin:admin@localhost:9200

# MinIO / S3 (local dev — use `docker compose up -d minio` to start one)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=smart_edms_minio
S3_SECRET_ACCESS_KEY=smart_edms_minio_dev_secret
S3_BUCKET=smart-edms-documents
S3_FORCE_PATH_STYLE=true

# JWT (generate with: openssl rand -hex 64)
JWT_SECRET=dev_jwt_secret_at_least_64_characters_long_for_testing_only_do_not_use_in_production_1234567890
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# CORS (comma-separated allowlist)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:3001

# License verification (optional in dev — without a public key, license state is "invalid"
# which still allows API access via the health + auth endpoints, but blocks most mutations)
# LICENSE_PUBLIC_KEY_PATH=./license-public-key.pem
# LICENSE_SERVER_URL=http://localhost:4001
LICENSE_HEARTBEAT_INTERVAL_SECONDS=3600
LICENSE_GRACE_PERIOD_DAYS=7
LICENSE_EXTENDED_REMEDIATION_DAYS=30

# AI Provider (set to "none" to disable AI in dev — returns localized "AI not configured" message)
AI_PROVIDER=none
# AI_PROVIDER=external
# AI_EXTERNAL_API_URL=https://api.openai.com/v1
# AI_EXTERNAL_API_KEY=sk-...
# AI_PROVIDER=local
# AI_LOCAL_API_URL=http://localhost:11434
AI_REQUEST_TIMEOUT_MS=30000

# Rate limits
RATE_LIMIT_GLOBAL_PER_MINUTE=200
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# Upload limits
UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/markdown,image/png,image/jpeg,image/gif,image/webp,image/tiff,video/mp4,audio/mpeg,audio/wav,application/vnd.ms-outlook,message/rfc822,text/html,application/json,application/xml,text/csv

# Webhooks (optional in dev)
WEBHOOK_SIGNING_SECRET=dev_webhook_secret

# Seed script defaults
SEED_ADMIN_EMAIL=admin@smart-edms.local
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_TENANT_CODE=default
SEED_TENANT_NAME=Default Tenant

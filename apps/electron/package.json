{
  "name": "@smart-edms/electron",
  "version": "1.0.0",
  "private": true,
  "description": "Smart EDMS Electron desktop client (secure, contextIsolation, sandbox, signed updates).",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build": "vite build && tsc -p tsconfig.node.json",
    "build:electron": "electron-builder",
    "typecheck": "tsc --noEmit",
    "lint": "echo skip",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@mantine/core": "^7.13.0",
    "@mantine/dates": "^7.13.0",
    "@mantine/dropzone": "^7.13.0",
    "@mantine/form": "^7.13.0",
    "@mantine/hooks": "^7.13.0",
    "@mantine/modals": "^7.13.0",
    "@mantine/notifications": "^7.13.0",
    "@smart-edms/ai-core": "workspace:*",
    "@smart-edms/i18n": "workspace:*",
    "@smart-edms/license-core": "workspace:*",
    "@smart-edms/schemas": "workspace:*",
    "@smart-edms/tour-core": "workspace:*",
    "@smart-edms/types": "workspace:*",
    "@smart-edms/ui": "workspace:*",
    "@smart-edms/utils": "workspace:*",
    "@tanstack/react-query": "^5.59.0",
    "@tabler/icons-react": "^3.46.0",
    "axios": "^1.7.7",
    "dayjs": "^1.11.13",
    "i18next": "^23.15.1",
    "lucide-react": "^0.445.0",
    "mantine-react-table": "^2.0.0-beta.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.2",
    "react-router-dom": "^6.26.2",
    "socket.io-client": "^4.7.5",
    "zod": "^3.23.8",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.2",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "electron": "^32.1.2",
    "electron-builder": "^25.0.5",
    "electron-updater": "^6.3.9",
    "typescript": "^5.6.2",
    "vite": "^5.4.6",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.1"
  }

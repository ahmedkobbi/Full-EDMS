// Smart EDMS — Licensing Server Prisma schema
//
// The licensing server is a SEPARATE service from the on-premise backend.
// It runs in the vendor's cloud/hosted environment and holds the private
// signing keys (spec §4.2, §7.3, §12).
//
// All tables are prefixed with `lic_` to keep the licensing server schema
// distinct from any other service that might share the same PostgreSQL
// cluster. The licensing server should ideally run in its own database
// anyway — its data model is small and its access patterns are different
// from the on-prem EDMS backend.
//
// Spec ref:
//   §4.2  — licensing server model
//   §12.1 — licensing server entity graph
//   §12.4 — signing keys (private never leaves the server)
//   §12.5 — license payload (signed artifact)
//   §12.6 — offline activation request
//   §12.7 — online activation flow
//   §12.8 — offline activation issue flow
//   §12.9 — heartbeat
//   §15.2 — licensing server side entities

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────────────────
// Customer & Contact
// ────────────────────────────────────────────────────────────────────────────

model Customer {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  email      String   @unique
  industry   String?  @db.VarChar(128)
  website    String?  @db.VarChar(512)
  status     String   @default("active") @db.VarChar(32)
  // Free-form metadata: billing ID, CRM link, region, etc.
  metadata   Json?
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  deletedAt  DateTime? @db.Timestamptz(3)

  contacts     Contact[]
  licenses     License[]
  trials       Trial[]
  webhooks     Webhook[]
  apiKeys      ApiKey[]
  auditLogs    LicenseAuditLog[]

  @@index([status])
  @@map("lic_customers")
}

model Contact {
  id         String   @id @default(uuid()) @db.Uuid
  customerId String   @db.Uuid
  name       String
  email      String
  role       String?  @db.VarChar(128)
  isPrimary  Boolean  @default(false)
  phone      String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([email])
  @@map("lic_contacts")
}

// ────────────────────────────────────────────────────────────────────────────
// Product & Plan
// ────────────────────────────────────────────────────────────────────────────

model Product {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique @db.VarChar(64)
  name            String
  description     String?
  currentVersion  String   @default("1.0.0") @db.VarChar(64)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  plans       Plan[]
  licenses    License[]
  trials      Trial[]
  offlineRequests OfflineActivationRequest[]

  @@map("lic_products")
}

model Plan {
  id          String   @id @default(uuid()) @db.Uuid
  productId   String   @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String
  description String?
  // Default entitlements included by this plan (array of EntitlementModule codes).
  features    Json     @default("[]")
  // Default numeric limits: { maxUsers, maxDevices, maxStorageBytes, maxDocuments, aiUsageAllowance, ... }
  limits      Json     @default("{}")
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  licenses    License[]

  @@index([productId])
  @@map("lic_plans")
}

// ────────────────────────────────────────────────────────────────────────────
// Signing Keys (spec §12.4)
//
// IMPORTANT: The PRIVATE key is NEVER stored in the database. Only the
// metadata (kid, algorithm, public key PEM, status) lives here. The private
// key is loaded at startup from `LICENSE_SIGNING_KEY_PATH` (a file readable
// only by the license-server process; chmod 600). For KMS/HSM deployments
// the private key never touches the filesystem — `kmsKeyId` references the
// KMS key identifier instead.
// ────────────────────────────────────────────────────────────────────────────

model SigningKey {
  id            String   @id @default(uuid()) @db.Uuid
  kid           String   @unique @db.VarChar(64)
  alg           String   @db.VarChar(32) // EdDSA | ES256
  // Public key in SPKI PEM form. Safe to expose.
  publicKeyPem  String   @db.Text
  // KMS/HSM key identifier when not loaded from disk. NULL when the key
  // is read from the filesystem (dev / single-tenant deployments).
  kmsKeyId      String?  @db.VarChar(512)
  status        String   @default("active") @db.VarChar(16) // active | rotating | retired | revoked
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  rotatedAt     DateTime? @db.Timestamptz(3)
  retiredAt     DateTime? @db.Timestamptz(3)

  licenses      License[]
  crlVersions   Revocation[]
  offlineCerts  OfflineActivationCertificate[]

  @@index([status])
  @@map("lic_signing_keys")
}

// ────────────────────────────────────────────────────────────────────────────
// License
// ────────────────────────────────────────────────────────────────────────────

model License {
  id                  String   @id @default(uuid()) @db.Uuid
  customerId          String   @db.Uuid
  productId           String   @db.Uuid
  planId              String   @db.Uuid
  // Human-readable license code (e.g. "SEDMS-PRO-2024-000123"). Unique.
  code                String   @unique @db.VarChar(128)
  // Activation code — the secret string the customer enters to activate a
  // deployment. Hashed at rest (never stored in plaintext). The plaintext
  // is shown only once at license creation time.
  activationCodeHash  String   @db.VarChar(128)
  // First 8 chars of the activation code, shown in the admin panel to
  // help identify the license without exposing the full code.
  activationCodePrefix String  @db.VarChar(16)
  status              String   @default("pending_activation") @db.VarChar(32)
  type                String   @db.VarChar(32) // trial | subscription | perpetual | enterprise | evaluation | partner
  environment         String   @default("production") @db.VarChar(16)
  signingKeyId        String   @db.Uuid
  // Payload version — bumped when entitlements/limits change so that
  // older deployments can detect that they need to re-activate.
  version             Int      @default(1)
  startDate           DateTime @db.Timestamptz(3)
  endDate             DateTime? @db.Timestamptz(3)
  gracePeriodDays     Int      @default(7)
  // Limits (denormalized from the plan at issuance time so that the
  // signed payload is stable even if the plan changes later).
  maxUsers            Int?
  maxDevices          Int?
  maxStorageBytes     BigInt?
  maxDocuments        Int?
  aiUsageAllowance    Int?     // monthly AI call allowance
  // Entitlements + features (also denormalized).
  enabledModules      String[] @default([])
  enabledIntegrations String[] @default([])
  featuresJson        Json     @default("[]")
  limitsJson          Json     @default("{}")
  offlineMode         Boolean  @default(true)
  hybridSync          Boolean  @default(false)
  supportLevel        String   @default("standard") @db.VarChar(32)
  // Monotonic counter incremented on each renewal (spec §12.5).
  renewalCounter      Int      @default(0)
  createdAt           DateTime @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @db.Timestamptz(3)
  revokedAt           DateTime? @db.Timestamptz(3)

  customer            Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)
  product             Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  plan                Plan     @relation(fields: [planId], references: [id], onDelete: Restrict)
  signingKey          SigningKey @relation(fields: [signingKeyId], references: [id], onDelete: Restrict)
  features            LicenseFeature[]
  limits              LicenseLimit[]
  activations         Activation[]
  devices             Device[]
  heartbeats          Heartbeat[]
  usageMetrics        UsageMetric[]
  revocations         Revocation[]
  offlineCerts        OfflineActivationCertificate[]

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([code])
  @@map("lic_licenses")
}

// Per-license feature flags (denormalized from the plan).
model LicenseFeature {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   String   @db.Uuid
  code        String   @db.VarChar(64)
  enabled     Boolean  @default(true)
  limits      Json?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  license     License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@unique([licenseId, code])
  @@map("lic_license_features")
}

// Per-license quantitative limits (numeric values; mirrors LicenseLimit).
model LicenseLimit {
  id          String   @id @default(uuid()) @db.Uuid
  licenseId   String   @db.Uuid
  code        String   @db.VarChar(64) // e.g. "maxUsers", "maxStorageBytes"
  value       Int
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  license     License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@unique([licenseId, code])
  @@map("lic_license_limits")
}

// ────────────────────────────────────────────────────────────────────────────
// Activation & Device (spec §12.7)
// ────────────────────────────────────────────────────────────────────────────

model Activation {
  id                String   @id @default(uuid()) @db.Uuid
  licenseId         String   @db.Uuid
  // The deployment ID is supplied by the on-prem backend at activation
  // time; it is a stable identifier for the deployment (typically a UUID
  // generated on first install). Multiple activations against the same
  // license but different deploymentIds are allowed up to maxDevices.
  deploymentId      String   @db.Uuid
  fingerprintHash   String   @db.VarChar(128)
  appVersion        String   @db.VarChar(64)
  environment       String   @db.VarChar(16)
  ipAddress         String?  @db.VarChar(64)
  status            String   @default("active") @db.VarChar(16) // pending | active | suspended | revoked | expired
  firstActivatedAt  DateTime @default(now()) @db.Timestamptz(3)
  lastHeartbeatAt   DateTime? @db.Timestamptz(3)
  deactivatedAt     DateTime? @db.Timestamptz(3)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  license           License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  devices           Device[]
  heartbeats        Heartbeat[]
  usageMetrics      UsageMetric[]

  @@index([licenseId])
  @@index([deploymentId])
  @@index([fingerprintHash])
  @@unique([licenseId, deploymentId])
  @@map("lic_activations")
}

model Device {
  id              String   @id @default(uuid()) @db.Uuid
  activationId    String   @db.Uuid
  licenseId       String   @db.Uuid
  fingerprintHash String   @db.VarChar(128)
  hostname        String?  @db.VarChar(256)
  os              String   @db.VarChar(64)
  arch            String   @db.VarChar(64)
  appVersion      String   @db.VarChar(64)
  firstSeenAt     DateTime @default(now()) @db.Timestamptz(3)
  lastSeenAt      DateTime @default(now()) @db.Timestamptz(3)
  revokedAt       DateTime? @db.Timestamptz(3)

  activation      Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)
  license         License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([activationId])
  @@index([licenseId])
  @@unique([activationId, fingerprintHash])
  @@map("lic_devices")
}

// ────────────────────────────────────────────────────────────────────────────
// Heartbeat & Usage (spec §12.9)
// ────────────────────────────────────────────────────────────────────────────

model Heartbeat {
  id                String   @id @default(uuid()) @db.Uuid
  activationId      String   @db.Uuid
  licenseId         String   @db.Uuid
  receivedAt        DateTime @default(now()) @db.Timestamptz(3)
  status            String   @db.VarChar(16) // healthy | degraded | offline_grace | revoked | unknown
  appVersion        String   @db.VarChar(64)
  fingerprintHash   String   @db.VarChar(128)
  usageSummary      Json
  responseSignature String?  @db.Text
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  activation        Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)
  license           License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)

  @@index([activationId])
  @@index([licenseId])
  @@index([receivedAt])
  @@map("lic_heartbeats")
}

model UsageMetric {
  id            String   @id @default(uuid()) @db.Uuid
  licenseId     String   @db.Uuid
  activationId  String   @db.Uuid
  // Metric key: "users" | "storage" | "documents" | "ai_calls"
  metric        String   @db.VarChar(32)
  value         BigInt
  recordedAt    DateTime @default(now()) @db.Timestamptz(3)

  license       License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  activation    Activation @relation(fields: [activationId], references: [id], onDelete: Cascade)

  @@index([licenseId])
  @@index([activationId])
  @@index([metric, recordedAt])
  @@map("lic_usage_metrics")
}

// ────────────────────────────────────────────────────────────────────────────
// Revocation (spec §12.4) — license IDs / fingerprints in the CRL
// ────────────────────────────────────────────────────────────────────────────

model Revocation {
  id                String   @id @default(uuid()) @db.Uuid
  licenseId         String   @db.Uuid
  reason            String   @db.Text
  revokedByAdminId  String?  @db.Uuid
  revokedAt         DateTime @default(now()) @db.Timestamptz(3)
  // Sequential CRL version this revocation was first included in.
  crlVersion        Int      @default(1)
  // Whether this revocation has been propagated to all deployments via
  // a published CRL (vs. pending propagation).
  propagated        Boolean  @default(false)
  // The signing key used to sign the CRL that included this revocation.
  // Usually the active key; may be a retiring key during rotation.
  signingKeyId      String   @db.Uuid
  fingerprint       String?  @db.VarChar(128) // optional device fingerprint revocation
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  license           License   @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  signingKey        SigningKey @relation(fields: [signingKeyId], references: [id], onDelete: Restrict)

  @@index([licenseId])
  @@index([crlVersion])
  @@map("lic_revocations")
}

// ────────────────────────────────────────────────────────────────────────────
// Trials (spec §12.10)
// ────────────────────────────────────────────────────────────────────────────

model Trial {
  id                   String   @id @default(uuid()) @db.Uuid
  customerId           String   @db.Uuid
  productId            String   @db.Uuid
  contactEmail         String   @db.VarChar(254)
  // Activation code bound to a single deployment (single-use).
  activationCode       String   @unique @db.VarChar(128)
  activationCodeHash   String   @db.VarChar(128)
  startDate            DateTime @default(now()) @db.Timestamptz(3)
  endDate              DateTime @db.Timestamptz(3)
  maxDurationDays      Int      @default(14)
  // Status: pending | active | expired | converted | cancelled
  status               String   @default("pending") @db.VarChar(16)
  // The license ID created when the trial is converted (if any).
  convertedToLicenseId String?  @db.Uuid
  // Feature limits applied to the trial license (default: limited
  // maxUsers, maxDocuments; no AI; no hybrid-sync).
  featureLimits        Json     @default("{}")
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product              Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([customerId])
  @@index([productId])
  @@index([status])
  @@index([contactEmail])
  @@map("lic_trials")
}

// ────────────────────────────────────────────────────────────────────────────
// Webhooks
// ────────────────────────────────────────────────────────────────────────────

model Webhook {
  id                 String   @id @default(uuid()) @db.Uuid
  customerId         String   @db.Uuid
  url                String   @db.VarChar(2048)
  // HMAC secret (hashed at rest; the plaintext is shown only once at
  // creation). The HMAC is sent in the `X-Smart-Edms-Signature` header
  // on every webhook delivery so the customer can verify authenticity.
  secretHash         String   @db.VarChar(128)
  // Events this webhook subscribes to (array of event codes).
  events             String[] @default([])
  isActive           Boolean  @default(true)
  lastDeliveryAt     DateTime? @db.Timestamptz(3)
  lastDeliveryStatus String?  @db.VarChar(32) // success | retrying | failed
  lastDeliveryCode   Int?
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @db.Timestamptz(3)

  customer           Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveries         WebhookDelivery[]

  @@index([customerId])
  @@index([isActive])
  @@map("lic_webhooks")
}

// Persisted record of each webhook delivery attempt (for the admin panel's
// "delivery log" view and for replay).
model WebhookDelivery {
  id              String   @id @default(uuid()) @db.Uuid
  webhookId       String   @db.Uuid
  event           String   @db.VarChar(64)
  payload         Json
  // Delivery attempts: [{ attempt, at, status, code, durationMs, error? }]
  attempts        Json     @default("[]")
  status          String   @default("pending") @db.VarChar(16) // pending | delivered | retrying | dead_lettered
  attemptsCount   Int      @default(0)
  nextRetryAt     DateTime? @db.Timestamptz(3)
  finalStatusCode Int?
  finalError      String?  @db.Text
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  webhook         Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@map("lic_webhook_deliveries")
}

// ────────────────────────────────────────────────────────────────────────────
// API Keys
//
// API keys authenticate on-premise backend calls to the licensing server
// (online activation, heartbeat). The on-prem backend stores the API key
// in its environment configuration and sends it as `X-Api-Key` header.
// ────────────────────────────────────────────────────────────────────────────

model ApiKey {
  id           String   @id @default(uuid()) @db.Uuid
  customerId   String   @db.Uuid
  name         String   @db.VarChar(128)
  keyHash      String   @unique @db.VarChar(128)
  keyPrefix    String   @db.VarChar(16) // first 8 chars, shown in admin UI
  scopes       String[] @default([]) // e.g. ["activation:online", "heartbeat:write", "license:read"]
  isActive     Boolean  @default(true)
  lastUsedAt   DateTime? @db.Timestamptz(3)
  expiresAt    DateTime? @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([isActive])
  @@map("lic_api_keys")
}

// ────────────────────────────────────────────────────────────────────────────
// Audit Log — hash-chained, append-only (spec §12.1, §21.7)
//
// The licensing server has its OWN audit log, distinct from the on-prem
// EDMS audit log, because it's a separate service. The hash chain uses
// the same pattern as the on-prem backend:
//   eventHash = sha256(`${previousHash}|${canonicalEvent}`)
// ────────────────────────────────────────────────────────────────────────────

model LicenseAuditLog {
  id              String   @id @default(uuid()) @db.Uuid
  // Admin user ID or "system" for automated events.
  adminId         String?  @db.VarChar(128)
  action          String   @db.VarChar(64) // customer.create, license.issue, license.revoke, etc.
  target          String?  @db.VarChar(256) // resource ID (no FK: target may be any entity type)
  metadata        Json     @default("{}")
  ipAddress       String?  @db.VarChar(64)
  userAgent       String?  @db.VarChar(512)
  occurredAt      DateTime @default(now()) @db.Timestamptz(3)
  // Hash-chain fields. sequenceNumber is a global monotonic counter
  // (across all events). previousHash is the eventHash of the prior
  // entry; eventHash is sha256(`${previousHash}|${canonicalEvent}`).
  sequenceNumber  Int      @default(1)
  previousHash    String?  @db.VarChar(64)
  eventHash       String   @db.VarChar(64)
  customerId      String?  @db.Uuid

  customer        Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([action])
  @@index([customerId])
  @@index([occurredAt])
  @@index([sequenceNumber])
  @@map("lic_audit_logs")
}

// ────────────────────────────────────────────────────────────────────────────
// Offline Activation Requests & Certificates (spec §12.6, §12.8)
// ────────────────────────────────────────────────────────────────────────────

model OfflineActivationRequest {
  id                     String   @id @default(uuid()) @db.Uuid
  requestId              String   @unique @db.Uuid // the requestId embedded in the .sedmsreq file
  productId              String   @db.Uuid
  deploymentId           String   @db.Uuid
  appVersion             String   @db.VarChar(64)
  machineFingerprint     Json
  installationPublicKey  String   @db.Text
  os                     String   @db.VarChar(64)
  arch                   String   @db.VarChar(64)
  contactEmail           String?  @db.VarChar(254)
  // Single-use nonce (sha256-hashed at rest so that a stolen DB dump
  // cannot be used to replay a request).
  nonceHash              String   @unique @db.VarChar(64)
  rawContent             String   @db.Text // the raw .sedmsreq file content
  status                 String   @default("pending") @db.VarChar(16) // pending | fulfilled | rejected | expired
  reviewedByAdminId      String?  @db.Uuid
  reviewedAt             DateTime? @db.Timestamptz(3)
  reviewNotes            String?  @db.Text
  // The license ID created/used to fulfill this request (if any).
  fulfilledLicenseId     String?  @db.Uuid
  // The signed artifact content (.sedmslic) handed back to the operator.
  fulfilledArtifact      String?  @db.Text
  fulfilledAt            DateTime? @db.Timestamptz(3)
  createdAt              DateTime @default(now()) @db.Timestamptz(3)

  product                Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  certificate            OfflineActivationCertificate?

  @@index([productId])
  @@index([deploymentId])
  @@index([status])
  @@map("lic_offline_activation_requests")
}

model OfflineActivationCertificate {
  id              String   @id @default(uuid()) @db.Uuid
  requestId       String   @unique @db.Uuid
  offlineRequestId String  @unique @db.Uuid
  licenseId       String   @db.Uuid
  signingKeyId    String   @db.Uuid
  artifactContent String   @db.Text // the signed .sedmslic content
  signedAt        DateTime @default(now()) @db.Timestamptz(3)
  signedByAdminId String?  @db.Uuid
  downloadedAt    DateTime? @db.Timestamptz(3)

  offlineRequest  OfflineActivationRequest @relation(fields: [offlineRequestId], references: [id], onDelete: Cascade)
  license         License  @relation(fields: [licenseId], references: [id], onDelete: Restrict)
  signingKey      SigningKey @relation(fields: [signingKeyId], references: [id], onDelete: Restrict)

  @@index([licenseId])
  @@index([signingKeyId])
  @@map("lic_offline_activation_certificates")
}

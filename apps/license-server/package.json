{
  "name": "@smart-edms/license-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Smart EDMS Licensing Server — control plane for license issuance, activation, revocation, heartbeats, trials, and webhook delivery (spec §4.2, §7.3, §12).",
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "echo skip",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "key:generate": "tsx scripts/generate-signing-key.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^12.0.1",
    "@fastify/rate-limit": "^10.1.0",
    "@nestjs/common": "^10.4.1",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.1",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-fastify": "^10.4.1",
    "@nestjs/schedule": "^4.1.0",
    "@nestjs/swagger": "^7.4.0",
    "@prisma/client": "^5.19.1",
    "@smart-edms/license-core": "workspace:*",
    "@smart-edms/schemas": "workspace:*",
    "@smart-edms/types": "workspace:*",
    "bcryptjs": "^2.4.3",
    "bullmq": "^5.13.0",
    "ioredis": "^5.4.1",
    "nestjs-pino": "^4.1.0",
    "otplib": "^12.0.1",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/node": "^20.14.0",
    "prisma": "^5.19.1",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }

# ─────────────────────────────────────────────────────────────────────────────
# Smart EDMS — Licensing Server Development Environment
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust values for local development.

# Environment
NODE_ENV=development
PORT=4001
HOST=0.0.0.0
LOG_LEVEL=debug

# PostgreSQL (separate database from the on-premise backend)
DATABASE_URL=postgresql://smart_edms:smart_edms_dev@localhost:5432/smart_edms_license?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT (separate secret from the on-premise backend — generate with: openssl rand -hex 64)
JWT_SECRET=dev_license_jwt_secret_at_least_64_chars_for_testing_only_do_not_use_in_production_1234567890

# License signing key (Ed25519 private key — NEVER commit the actual key)
# Generate with: pnpm --filter @smart-edms/license-server key:generate
LICENSE_SIGNING_KEY_PATH=./license-signing-key.pem
LICENSE_SIGNING_KID=dev_signing_key_kid
LICENSE_SIGNING_ALG=EdDSA

# CORS (comma-separated allowlist — includes the License Admin Panel origin)
CORS_ORIGINS=http://localhost:5174,http://localhost:3000

# Rate limits (per IP)
RATE_LIMIT_GLOBAL_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=5

# Seed script defaults
SEED_SUPER_ADMIN_EMAIL=superadmin@smart-edms.example
SEED_SUPER_ADMIN_PASSWORD=ChangeMe!2026

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",
    "composite": false,
    "noEmit": true,
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "incremental": false,
    "composite": false
  },
  "include": ["src/**/*.ts", "resources/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}

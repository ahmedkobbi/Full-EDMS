{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "paths": {
      "@smart-edms/types": ["../types/src/index.ts"],
      "@smart-edms/types/*": ["../types/src/*"],
      "@smart-edms/schemas": ["../schemas/src/index.ts"],
      "@smart-edms/schemas/*": ["../schemas/src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "../types/src/**/*.ts",
    "../schemas/src/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}

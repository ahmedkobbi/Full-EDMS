# ─────────────────────────────────────────────────────────────────────────────
# Smart EDMS — On-Premise Backend Environment
# ─────────────────────────────────────────────────────────────────────────────

# Environment
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL
POSTGRES_USER=smart_edms
POSTGRES_PASSWORD=CHANGE_ME_strong_password_at_least_32_chars
POSTGRES_DB=smart_edms
DATABASE_URL=postgresql://smart_edms:CHANGE_ME_strong_password_at_least_32_chars@postgres:5432/smart_edms?schema=public

# Redis
REDIS_URL=redis://redis:6379

# OpenSearch
OPENSEARCH_URL=http://admin:CHANGE_ME_opensearch_password@opensearch:9200
OPENSEARCH_ADMIN_PASSWORD=CHANGE_ME_AtLeast16charsWithUpperLowerDigitSpecial!

# MinIO / S3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=smart_edms_minio
S3_SECRET_ACCESS_KEY=CHANGE_ME_strong_secret_at_least_32_chars
S3_BUCKET=smart-edms-documents
S3_FORCE_PATH_STYLE=true

# JWT
JWT_SECRET=CHANGE_ME_at_least_64_random_chars_for_jwt_secret_use_openssl_rand_hex_64
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# CORS (comma-separated allowlist)
CORS_ORIGINS=https://smart-edms.your-domain.com,http://localhost:5173

# License verification
LICENSE_PUBLIC_KEY_PATH=/run/secrets/license-public-key.pem
LICENSE_SERVER_URL=http://license-server:4001
LICENSE_HEARTBEAT_INTERVAL_SECONDS=3600
LICENSE_GRACE_PERIOD_DAYS=7
LICENSE_EXTENDED_REMEDIATION_DAYS=30

# AI Provider
AI_PROVIDER=none
# AI_PROVIDER=external
# AI_EXTERNAL_API_URL=https://api.openai.com/v1
# AI_EXTERNAL_API_KEY=sk-...
# AI_PROVIDER=local
# AI_LOCAL_API_URL=http://localhost:11434
AI_REQUEST_TIMEOUT_MS=30000

# Rate limits
RATE_LIMIT_GLOBAL_PER_MINUTE=200
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# Upload limits
UPLOAD_MAX_SIZE_BYTES=5368709120
UPLOAD_ALLOWED_MIME_TYPES=application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/vnd.openxmlformats-officedocument.presentationml.presentation,text/plain,text/markdown,image/png,image/jpeg,image/gif,image/webp,image/tiff,video/mp4,audio/mpeg,audio/wav,application/vnd.ms-outlook,message/rfc822,text/html,application/json,application/xml,text/csv

# Webhooks
WEBHOOK_SIGNING_SECRET=CHANGE_ME_for_signing_outgoing_webhooks

# ─────────────────────────────────────────────────────────────────────────────
# Licensing Server
# ─────────────────────────────────────────────────────────────────────────────
LICENSE_JWT_SECRET=CHANGE_ME_at_least_64_random_chars_for_license_jwt_secret
LICENSE_SIGNING_KID=CHANGE_ME_derived_from_your_public_key
LICENSE_SIGNING_ALG=EdDSA

# ─────────────────────────────────────────────────────────────────────────────
# Reverse Proxy
# ─────────────────────────────────────────────────────────────────────────────
SMART_EDMS_HTTP_PORT=80
SMART_EDMS_HTTPS_PORT=443
